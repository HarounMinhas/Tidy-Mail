<div class="tm-results">
    <div class="tm-info-strip" role="note">Filtering and selection use the local mailbox snapshot. Gmail is contacted only when an action is confirmed.</div>
    <section class="tm-panel tm-filter-panel">
        <div class="tm-panel-heading">
            <div><h2>Filter messages</h2><p>Find what to keep, archive or move to Trash.</p></div>
            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ToggleFilterPanel">@(showFilters ? "Hide filters" : "Show filters")</button>
        </div>
        @if (showFilters)
        {
            <div class="tm-filter-grid">
                <div><label class="form-label" for="tm-sender-filter">Sender</label><input id="tm-sender-filter" class="form-control" @bind="SearchTerm" @bind:event="oninput" placeholder="Name or email" /></div>
                <div><label class="form-label" for="tm-domain-filter">Domain</label><input id="tm-domain-filter" class="form-control" list="domain-options" @bind="DomainFilter" @bind:event="oninput" placeholder="example.com" /><datalist id="domain-options">@foreach (var domain in availableDomains) { <option value="@domain"></option> }</datalist></div>
                <div><label class="form-label" for="tm-keyword-filter">Subject or keyword</label><input id="tm-keyword-filter" class="form-control" list="message-query-options" @bind="MessageQuery" @bind:event="oninput" placeholder="Search metadata" /><datalist id="message-query-options">@foreach (var suggestion in querySuggestions) { <option value="@suggestion"></option> }</datalist></div>
                <div><label class="form-label" for="tm-read-filter">Read status</label><select id="tm-read-filter" class="form-select" @bind="MessageStatusFilter"><option value="">All</option><option value="Unread">Unread</option><option value="Read">Read</option></select></div>
                <div><label class="form-label" for="tm-age-filter">Older than</label><select id="tm-age-filter" class="form-select" @bind="AgeFilter"><option value="">Any age</option><option value="6m">6 months</option><option value="1y">1 year</option></select></div>
                <div><label class="form-label" for="tm-folder-filter">Folder</label><select id="tm-folder-filter" class="form-select" @bind="FolderFilter"><option value="">All folders</option>@foreach (var folder in ExistingFolders) { <option value="@folder">@folder</option> }</select></div>
                <div><label class="form-label" for="tm-label-filter">Gmail label</label><select id="tm-label-filter" class="form-select" @bind="GmailLabelFilter"><option value="">All labels</option>@foreach (var label in existingLabels) { <option value="@label.Id">@label.Name</option> }</select></div>
                <div><label class="form-label" for="tm-attachment-filter">Attachments</label><select id="tm-attachment-filter" class="form-select" @bind="AttachmentFilterValue"><option value="">Any</option><option value="true">Has attachment</option><option value="false">No attachment</option></select></div>
            </div>
            <div class="d-flex flex-wrap gap-4 mt-3">
                <label class="form-check-label"><input class="form-check-input me-2" type="checkbox" @bind="NoreplyOnly" />No-reply only</label>
                <label class="form-check-label"><input class="form-check-input me-2" type="checkbox" @bind="NewsletterOnly" />Likely newsletters</label>
                <label class="form-check-label"><input class="form-check-input me-2" type="checkbox" @bind="NotificationOnly" />Notifications</label>
            </div>
        }
    </section>

    @if (isLoading)
    {
        <div class="tm-panel" role="status"><span class="spinner-border spinner-border-sm me-2"></span>@progressMessage</div>
    }
    @if (!string.IsNullOrWhiteSpace(SuggestedSelectionTitle) && suggestedSelectionCount > 0)
    {
        <div class="alert alert-info" role="status"><strong>Review: @SuggestedSelectionTitle</strong> — @suggestedSelectionCount selected. No action has been performed. Inspect the selection and choose an action below.</div>
    }
    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="alert alert-success" role="status">@successMessage</div>
    }
    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger" role="alert">@errorMessage
            @if (NeedsGmailReconnect) { <div class="mt-2"><a href="/auth/login" class="btn btn-sm btn-outline-primary">Reconnect Google account</a></div> }
        </div>
    }
    @if (lastActionResult is not null)
    {
        <div class="alert @(lastActionResult.RequiresReconciliation ? "alert-warning" : "alert-success")" role="status">
            <strong>Last Gmail action: @lastActionKind</strong> — acknowledged @lastActionResult.TotalSucceeded of @lastActionResult.TotalRequested; @lastActionResult.TotalFailed rejected; @lastActionResult.TotalUnknown uncertain.
            @if (lastActionResult.CacheUpdateFailed) { <div>Local cache update failed. Check Gmail before retrying.</div> }
            @if (lastActionResult.TotalUnknown > 0) { <div>Some outcomes are uncertain. Do not retry those messages before checking Gmail.</div> }
            @if (lastActionResult.TotalFailed > 0)
            {
                <div class="mt-2"><button type="button" class="btn btn-sm btn-outline-dark" disabled="@(actionInProgress || !canRetryRejected)" @onclick="ReviewRejectedMessages">Select rejected messages for new preview</button></div>
            }
            @if (lastActionResult.ErrorMessages.Count > 0) { <div class="small mt-2">@string.Join(" | ", lastActionResult.ErrorMessages.Take(3))</div> }
        </div>
    }
    @if (!isLoading)
    {
        <section class="tm-panel tm-results-list">
            <div class="tm-panel-heading">
                <div><h2>@visibleMessageIds.Count.ToString("N0") matching messages</h2><p>Grouped by sender. Expand a sender to review individual emails.</p></div>
                <div class="d-flex flex-wrap gap-2 align-items-center">
                    <label class="form-label mb-0" for="tm-sort-field">Sort senders</label>
                    <select id="tm-sort-field" class="form-select form-select-sm" style="width:auto" @bind="SortField"><option value="Count">Email count</option><option value="Name">Sender name</option><option value="Email">Email address</option><option value="Newest">Newest email</option><option value="Oldest">Oldest email</option></select>
                    <select aria-label="Sort direction" class="form-select form-select-sm" style="width:auto" @bind="SortDirection"><option value="Desc">Descending</option><option value="Asc">Ascending</option></select>
                </div>
            </div>
            @if (!filteredSenders.Any())
            {
                <div class="tm-empty">No messages match these filters.</div>
            }
            else
            {
                <div class="tm-selection-bar">
                    <span class="tm-selection-count">@engine.SelectedMessageIds.Count.ToString("N0") selected</span>
                    <button type="button" class="btn btn-sm btn-outline-primary" disabled="@actionInProgress" @onclick="SelectVisible">Select all matching</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(actionInProgress || engine.SelectedMessageIds.Count == 0)" @onclick="ClearSelection">Clear selection</button>
                </div>
                @if (HiddenSelectedCount > 0)
                {
                    <div class="alert alert-warning" role="status">@HiddenSelectedCount selected messages are hidden by the current filters. Bulk actions will include them; review this before confirming.</div>
                }
                @foreach (var sender in PagedSenders)
                {
                    var senderMessages = filteredBySender.TryGetValue(sender.Email, out var rows) ? rows : new List<MailItemDto>();
                    if (senderMessages.Count == 0) { continue; }
                    var expanded = engine.ExpandedSenders.Contains(sender.Email);
                    <div class="card mb-2">
                        <div class="card-header d-flex align-items-center justify-content-between gap-2">
                            <div class="d-flex align-items-center gap-2 flex-grow-1">
                                <input type="checkbox" aria-label="Select sender messages" checked="@engine.IsSenderFullySelected(sender.Email, senderMessages.Select(m => m.Id).ToList())" @onchange="args => ToggleSenderSelection(sender.Email, args)" />
                                <button type="button" class="btn btn-link tm-result-expand text-decoration-none" @onclick="() => ToggleSender(sender.Email)">@(expanded ? "▾" : "▸") @sender.Name <small class="text-muted">(@sender.Email)</small></button>
                            </div>
                            <span class="small text-muted">@senderMessages.Count.ToString("N0") matching · @sender.Count.ToString("N0") total</span>
                        </div>
                        @if (expanded)
                        {
                            <div class="card-body p-0">
                                <table class="table table-sm table-striped mb-0">
                                    <thead><tr><th>Select</th><th>Subject</th><th>Received</th><th>Status</th><th>Attachment</th><th>Folder</th></tr></thead>
                                    <tbody>
                                        @foreach (var message in senderMessages.Take(50))
                                        {
                                            <tr><td><input type="checkbox" aria-label="Select email" checked="@engine.SelectedMessageIds.Contains(message.Id)" @onchange="args => ToggleMessageSelection(message.Id, args)" /></td>
                                                <td>@message.Subject</td><td>@(message.ReceivedAt?.ToLocalTime().ToString("dd MMM yyyy") ?? "Unknown")</td><td>@(message.IsRead ? "Read" : "Unread")</td><td>@(message.HasAttachment ? "Yes" : "No")</td><td>@message.Folder</td></tr>
                                        }
                                    </tbody>
                                </table>
                                @if (senderMessages.Count > 50)
                                {
                                    <div class="p-2 small text-muted">Showing the first 50 matching messages from this sender. All @senderMessages.Count messages still match the current filters and can be selected with the sender checkbox.</div>
                                }
                            </div>
                        }
                    </div>
                }
                <div class="d-flex align-items-center justify-content-between mt-3 gap-2">
                    <small class="text-muted">Senders @(senderPage * SendersPerPage + 1)–@Math.Min((senderPage + 1) * SendersPerPage, filteredSenders.Count) of @filteredSenders.Count</small>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(senderPage == 0)" @onclick="() => ChangeSenderPage(senderPage - 1)">Previous</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(senderPage + 1 >= SenderPageCount)" @onclick="() => ChangeSenderPage(senderPage + 1)">Next</button>
                    </div>
                </div>
            }
        </section>
        @if (filteredSenders.Any())
        {
            <section class="tm-action-toolbar" aria-label="Bulk actions">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <strong>@engine.SelectedMessageIds.Count.ToString("N0") emails selected</strong>
                    <div class="d-flex flex-wrap gap-2">
                        <button class="btn btn-outline-primary btn-sm" disabled="@(engine.SelectedMessageIds.Count == 0 || actionInProgress)" @onclick="() => OpenActionPane(MailBulkAction.Archive)">Archive</button>
                        <button class="btn btn-outline-primary btn-sm" disabled="@(engine.SelectedMessageIds.Count == 0 || actionInProgress)" @onclick="() => OpenActionPane(MailBulkAction.MarkRead)">Mark read</button>
                        <button class="btn btn-outline-primary btn-sm" disabled="@(engine.SelectedMessageIds.Count == 0 || actionInProgress)" @onclick="() => OpenActionPane(MailBulkAction.MarkUnread)">Mark unread</button>
                        <button class="btn btn-outline-primary btn-sm" disabled="@(engine.SelectedMessageIds.Count == 0 || actionInProgress)" @onclick="() => OpenActionPane(MailBulkAction.Move)">Move to label</button>
                        <button class="btn btn-outline-primary btn-sm" disabled="@(engine.SelectedMessageIds.Count == 0 || actionInProgress)" @onclick="() => OpenActionPane(MailBulkAction.AddLabel)">Add label</button>
                        <button class="btn btn-outline-danger btn-sm" disabled="@(engine.SelectedMessageIds.Count == 0 || actionInProgress)" @onclick="() => OpenActionPane(MailBulkAction.Delete)">Move to Trash</button>
                    </div>
                </div>
            </section>
        }
    }

    @if (showActionPane && pendingAction.HasValue)
    {
        <div class="tm-modal-backdrop" role="presentation">
            <div class="tm-dialog" role="dialog" aria-modal="true" aria-labelledby="tm-action-title">
                <div class="tm-dialog-header">
                    <div><h2 id="tm-action-title">Preview: @ActionDisplayName</h2><p>Review the messages and details before anything changes in Gmail.</p></div>
                    <button type="button" class="tm-dialog-close" aria-label="Close preview" disabled="@actionInProgress" @onclick="CancelAction">×</button>
                </div>
                <div class="tm-dialog-summary">
                    <div><strong>@(actionPreview?.SelectedCount.ToString("N0") ?? "0") messages</strong><span>Included in this action</span></div>
                    <div><strong>@(previewMessages.Select(m => m.SenderEmail).Distinct(StringComparer.OrdinalIgnoreCase).Count()) senders</strong><span>Across the selected messages</span></div>
                </div>
                @if (HiddenSelectedCount > 0)
                {
                    <div class="alert alert-warning">This includes @HiddenSelectedCount messages hidden by your filters.</div>
                    <label class="d-block mb-3"><input type="checkbox" class="form-check-input me-2" @bind="acknowledgesHiddenSelection" />Include hidden selected messages</label>
                }
                @if (pendingAction == MailBulkAction.Delete)
                {
                    <div class="alert alert-warning">These messages will be moved to Gmail Trash. Review carefully.</div>
                    @if (RequiresExtraConfirmation)
                    {
                        <div class="alert alert-danger">Some messages are unread, recent, starred or important.</div>
                        <label class="d-block mb-3"><input type="checkbox" class="form-check-input me-2" @bind="acknowledgesRisk" />I reviewed the potentially important messages.</label>
                    }
                }
                @if (pendingAction == MailBulkAction.Move || pendingAction == MailBulkAction.AddLabel)
                {
                    <div class="alert alert-info">@(pendingAction == MailBulkAction.Move ? "Move removes the Inbox and other custom labels. System flags remain unchanged." : "Add label keeps the existing labels and Inbox state.")</div>
                    <div class="row g-2 mb-3">
                        <div class="col-md-6"><label class="form-label" for="tm-target-label">Existing Gmail label</label><select id="tm-target-label" class="form-select" @bind="selectedDestinationLabelId"><option value="">Select label</option>@foreach (var label in MoveDestinationLabels) { <option value="@label.Id">@label.Name</option> }</select></div>
                        <div class="col-md-6"><label class="form-label" for="tm-new-label">Or create a new label</label><input id="tm-new-label" class="form-control" @bind="newFolderName" placeholder="Label name" /></div>
                    </div>
                }
                <h3 class="h6">Sample of affected messages</h3>
                <ul class="tm-dialog-samples">
                    @foreach (var message in previewMessages.Take(8))
                    {
                        <li><strong>@message.SenderEmail</strong> — @message.Subject</li>
                    }
                </ul>
                @if (actionInProgress) { <p class="text-primary" role="status">@progressMessage</p> }
                <div class="tm-dialog-footer">
                    <button type="button" class="btn btn-outline-secondary" disabled="@actionInProgress" @onclick="CancelAction">Cancel</button>
                    <button type="button" class="btn btn-primary" disabled="@(!CanConfirmAction)" @onclick="ConfirmAction">@(actionInProgress ? "Working…" : "Confirm action")</button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private string ActionDisplayName => pendingAction switch
    {
        MailBulkAction.Delete => "Move to Trash",
        MailBulkAction.Archive => "Archive messages",
        MailBulkAction.MarkRead => "Mark as read",
        MailBulkAction.MarkUnread => "Mark as unread",
        MailBulkAction.Move => "Move to label",
        MailBulkAction.AddLabel => "Add label",
        _ => "Bulk action"
    };
    private bool isLoading = true;
    private bool showFilters = true;
    private int senderPage = 0;
    private const int SendersPerPage = 20;
    [Parameter] public string? InitialSenderFilter { get; set; }
    [Parameter] public string? InitialDomainFilter { get; set; }
    private int SenderPageCount => Math.Max(1, (filteredSenders.Count + SendersPerPage - 1) / SendersPerPage);
    private IEnumerable<SenderStatDto> PagedSenders => filteredSenders.Skip(senderPage * SendersPerPage).Take(SendersPerPage);
    private void ChangeSenderPage(int page) => senderPage = Math.Clamp(page, 0, SenderPageCount - 1);
    private string searchTerm = string.Empty;
    private string domainFilter = string.Empty;
    private bool noreplyOnly;

    private List<SenderStatDto> allSenders = new();
    private List<SenderStatDto> filteredSenders = new();
    private List<string> availableDomains = new();

    private IReadOnlyCollection<MailItemDto> allMessages = Array.Empty<MailItemDto>();
    private IReadOnlyCollection<MailItemDto> filteredMessages = Array.Empty<MailItemDto>();
    private Dictionary<string, List<MailItemDto>> filteredBySender = new(StringComparer.OrdinalIgnoreCase);
    private HashSet<string> visibleMessageIds = new(StringComparer.OrdinalIgnoreCase);
    private List<string> querySuggestions = new();

    private string messageQuery = string.Empty;
    private string messageStatusFilter = string.Empty;
    private string folderFilter = string.Empty;
    private string attachmentFilterValue = string.Empty;
    private string ageFilter = string.Empty;
    private string gmailLabelFilter = string.Empty;
    private bool newsletterOnly;
    private bool notificationOnly;

    private MailManagementEngine engine = new(Array.Empty<MailItemDto>());

    private bool showActionPane;
    private MailBulkAction? pendingAction;
    private ActionPreview? actionPreview;
    private List<MailItemDto> previewMessages = new();
    private bool acknowledgesRisk;
    private bool acknowledgesHiddenSelection;
    [Parameter] public EventCallback OnMailboxChanged { get; set; }
    [Parameter] public IReadOnlyCollection<string> InitialSelectedMessageIds { get; set; } = Array.Empty<string>();
    [Parameter] public string? SuggestedSelectionTitle { get; set; }
    private int suggestedSelectionCount;
    private string selectedDestinationLabelId = string.Empty;
    private string newFolderName = string.Empty;
    private List<MailboxCleaner.Web.Infrastructure.Google.GmailLabel> existingLabels = new();
    private bool actionInProgress;
    private string progressMessage = "Loading Gmail metadata…";
    private string successMessage = string.Empty;
    private string errorMessage = string.Empty;
    private GmailBulkActionResult? lastActionResult;
    private MailBulkAction? lastActionKind;
    private bool canRetryRejected;
    private bool NeedsGmailReconnect => errorMessage.Contains("sign in again", StringComparison.OrdinalIgnoreCase)
        || errorMessage.Contains("token missing", StringComparison.OrdinalIgnoreCase)
        || errorMessage.Contains("token expired", StringComparison.OrdinalIgnoreCase);
    private string sortField = "Count";
    private string sortDirection = "Desc";

    private IEnumerable<string> ExistingFolders => allMessages.Select(message => message.Folder)
        .Where(folder => !string.IsNullOrWhiteSpace(folder))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(folder => folder);

    private IReadOnlyList<MailboxCleaner.Web.Infrastructure.Google.GmailLabel> MoveDestinationLabels => existingLabels
        .Where(label => !label.IsSystemLabel)
        .OrderBy(label => label.Name)
        .ToList();

    private int HiddenSelectedCount => engine.CountSelectedOutside(visibleMessageIds);

    private bool RequiresExtraConfirmation => pendingAction == MailBulkAction.Delete && previewMessages.Any(message =>
        !message.IsRead || message.ReceivedAt >= DateTimeOffset.UtcNow.AddDays(-30)
        || message.LabelIds?.Contains("STARRED", StringComparer.OrdinalIgnoreCase) == true
        || message.LabelIds?.Contains("IMPORTANT", StringComparer.OrdinalIgnoreCase) == true);

    private bool CanConfirmAction => !actionInProgress
        && (HiddenSelectedCount == 0 || acknowledgesHiddenSelection)
        && (!RequiresExtraConfirmation || acknowledgesRisk)
        && pendingAction.HasValue
        && actionPreview is not null
        && actionPreview.SelectedCount > 0
        && ((pendingAction != MailBulkAction.Move && pendingAction != MailBulkAction.AddLabel)
            || !string.IsNullOrWhiteSpace(newFolderName) || !string.IsNullOrWhiteSpace(selectedDestinationLabelId));

    protected override async Task OnInitializedAsync()
    {
        searchTerm = InitialSenderFilter ?? string.Empty;
        domainFilter = InitialDomainFilter ?? string.Empty;
        await RefreshAsync();
        if (InitialSelectedMessageIds.Count > 0)
        {
            var availableIds = allMessages.Select(message => message.Id).ToHashSet(StringComparer.OrdinalIgnoreCase);
            foreach (var messageId in InitialSelectedMessageIds)
                if (availableIds.Contains(messageId)) engine.ToggleMessageSelection(messageId, true);
            suggestedSelectionCount = engine.SelectedMessageIds.Count;
            // Suggestions only select messages for review. An action requires a separate click and confirmation.
            foreach (var sender in allMessages.Where(m => engine.SelectedMessageIds.Contains(m.Id))
                .Select(m => m.SenderEmail).Distinct(StringComparer.OrdinalIgnoreCase).Take(5))
                engine.ToggleSenderExpansion(sender);
        }
    }

    private async Task<bool> RefreshAsync(bool fromGmail = false)
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            progressMessage = "Loading Gmail metadata…";
            allMessages = (fromGmail
                ? await OverviewService.ReconcileMailItemsAsync(CancellationToken.None)
                : await OverviewService.GetMailItemsAsync(CancellationToken.None)).ToList();
            allSenders = BuildSenderStats(allMessages);
            existingLabels = (await OverviewService.GetLabelsAsync(CancellationToken.None)).ToList();
            selectedDestinationLabelId = string.Empty;

            engine = new MailManagementEngine(allMessages);
            suggestedSelectionCount = 0;

            availableDomains = allSenders.Select(sender => sender.Domain)
                .Where(domain => !string.IsNullOrWhiteSpace(domain))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(domain => domain)
                .ToList();

            ApplyFilters();
            return true;
        }
        catch (Exception ex)
        {
            errorMessage = $"Unable to load mailbox metadata. {ex.Message}";
            return false;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ApplyFilters()
    {
        IEnumerable<SenderStatDto> senderResults = allSenders;

        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            senderResults = senderResults.Where(sender =>
                sender.Email.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)
                || sender.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(domainFilter))
        {
            senderResults = senderResults.Where(sender => sender.Domain.Contains(domainFilter, StringComparison.OrdinalIgnoreCase));
        }

        if (noreplyOnly)
        {
            senderResults = senderResults.Where(sender => sender.Email.Contains("noreply", StringComparison.OrdinalIgnoreCase));
        }

        filteredMessages = engine.FilterMessages(messageQuery, messageStatusFilter, folderFilter,
            ParseAttachmentFilter(), ageFilter, newsletterOnly, notificationOnly, gmailLabelFilter);
        filteredBySender = filteredMessages.GroupBy(message => message.SenderEmail, StringComparer.OrdinalIgnoreCase)
            .ToDictionary(group => group.Key, group => group.ToList(), StringComparer.OrdinalIgnoreCase);
        var visibleSenderEmails = filteredBySender.Keys.ToHashSet(StringComparer.OrdinalIgnoreCase);
        filteredSenders = SortSenders(senderResults.Where(sender => visibleSenderEmails.Contains(sender.Email))).ToList();
        var renderedSenders = filteredSenders.Select(sender => sender.Email).ToHashSet(StringComparer.OrdinalIgnoreCase);
        visibleMessageIds = filteredMessages.Where(m => renderedSenders.Contains(m.SenderEmail))
            .Select(m => m.Id).ToHashSet(StringComparer.OrdinalIgnoreCase);
        if (showActionPane) acknowledgesHiddenSelection = false;
        querySuggestions = engine.AutocompleteSuggestions(messageQuery).ToList();
        senderPage = Math.Clamp(senderPage, 0, SenderPageCount - 1);
    }

    private bool? ParseAttachmentFilter() => attachmentFilterValue switch
    {
        "true" => true,
        "false" => false,
        _ => null
    };

    private void ToggleSender(string senderEmail)
    {
        engine.ToggleSenderExpansion(senderEmail);
    }

    private void ToggleSenderSelection(string senderEmail, ChangeEventArgs args)
    {
        var isChecked = args.Value is bool value && value;
        var visibleIds = filteredBySender.TryGetValue(senderEmail, out var visibleMessages)
            ? visibleMessages.Select(message => message.Id).ToList()
            : new List<string>();
        engine.ToggleSenderSelection(senderEmail, isChecked, visibleIds);
        if (suggestedSelectionCount > 0) suggestedSelectionCount = engine.SelectedMessageIds.Count;
        InvalidatePreview();
    }

    private void SelectVisible()
    {
        var visibleSenders = filteredSenders.Select(s => s.Email).ToHashSet(StringComparer.OrdinalIgnoreCase);
        engine.SelectMessages(filteredMessages.Where(m => visibleSenders.Contains(m.SenderEmail)).Select(m => m.Id));
        if (suggestedSelectionCount > 0) suggestedSelectionCount = engine.SelectedMessageIds.Count;
        InvalidatePreview();
    }

    private void ClearSelection()
    {
        engine.ClearSelection();
        suggestedSelectionCount = 0;
        InvalidatePreview();
    }

    private void ToggleMessageSelection(string messageId, ChangeEventArgs args)
    {
        var isChecked = args.Value is bool value && value;
        engine.ToggleMessageSelection(messageId, isChecked);
        if (suggestedSelectionCount > 0) suggestedSelectionCount = engine.SelectedMessageIds.Count;
        InvalidatePreview();
    }

    private void InvalidatePreview()
    {
        if (showActionPane && !actionInProgress) CancelAction();
    }

    private void OpenActionPane(MailBulkAction action)
    {
        acknowledgesRisk = false;
        acknowledgesHiddenSelection = false;
        pendingAction = action;
        showActionPane = true;
        actionPreview = engine.PreviewAction(action, selectedDestinationLabelId);
        var ids = actionPreview.MessageIds.ToHashSet(StringComparer.OrdinalIgnoreCase);
        previewMessages = allMessages.Where(message => ids.Contains(message.Id)).ToList();
    }

    private async Task ConfirmAction()
    {
        if (!CanConfirmAction || pendingAction is null || actionPreview is null) return;
        if (!actionPreview.MessageIds.ToHashSet(StringComparer.OrdinalIgnoreCase).SetEquals(engine.SelectedMessageIds))
        {
            CancelAction();
            errorMessage = "The selection changed. Review the updated selection before confirming.";
            return;
        }

        var action = pendingAction.Value;
        var messageIds = actionPreview.MessageIds.ToList();
        try
        {
            actionInProgress = true;
            progressMessage = $"Sending {action} for {messageIds.Count} messages…";
            errorMessage = string.Empty;
            successMessage = string.Empty;
            lastActionResult = null;
            canRetryRejected = false;

            var result = await OverviewService.ApplyActionWithResultAsync(action, messageIds,
                selectedDestinationLabelId, newFolderName, CancellationToken.None);
            lastActionResult = result;
            lastActionKind = action;

            // Created labels must be reused for any later retry, never recreated blindly.
            if (!string.IsNullOrWhiteSpace(result.TargetLabelId))
                selectedDestinationLabelId = result.TargetLabelId;
            newFolderName = string.Empty;
            CancelAction();

            if (result.RequiresReconciliation)
            {
                errorMessage = "Gmail returned rejected or uncertain results. The mailbox is being reloaded; " +
                    "only definitively rejected messages can be offered for retry.";
                var refreshed = await RefreshAsync(fromGmail: true);
                canRetryRejected = refreshed && result.TotalFailed > 0;
                if (canRetryRejected)
                    engine.SelectMessages(result.FailedMessageIds);
                else if (!refreshed)
                    errorMessage = "Gmail reconciliation failed. No retry is available until the mailbox has been refreshed successfully.";
            }
            else
            {
                successMessage = $"Gmail acknowledged {result.TotalSucceeded} of {result.TotalRequested} messages.";
                await RefreshAsync();
            }

            await OnMailboxChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Could not complete the action: {ex.Message}. Check Gmail before retrying.";
            // The operation might have reached Gmail. Never report a definitive failure here.
        }
        finally
        {
            actionInProgress = false;
            progressMessage = "Loading Gmail metadata…";
        }
    }

    private void ReviewRejectedMessages()
    {
        if (actionInProgress || !canRetryRejected || lastActionResult is null || lastActionKind is null ||
            lastActionResult.TotalFailed == 0) return;

        engine.ClearSelection();
        engine.SelectMessages(lastActionResult.FailedMessageIds);
        if (engine.SelectedMessageIds.Count == 0)
        {
            errorMessage = "Rejected messages are no longer present in this mailbox view. Rescan before retrying.";
            return;
        }

        var action = lastActionKind.Value;
        if (!string.IsNullOrWhiteSpace(lastActionResult.TargetLabelId))
        {
            selectedDestinationLabelId = lastActionResult.TargetLabelId;
            newFolderName = string.Empty; // do not recreate a new Gmail label on retry
        }
        OpenActionPane(action); // Always require a fresh preview and confirmation.
    }

    private void CancelAction()
    {
        showActionPane = false;
        pendingAction = null;
        actionPreview = null;
        previewMessages.Clear();
        acknowledgesRisk = false;
        acknowledgesHiddenSelection = false;
        newFolderName = string.Empty;
    }

    private void ToggleFilterPanel() => showFilters = !showFilters;


    private static List<SenderStatDto> BuildSenderStats(IEnumerable<MailItemDto> messages) => messages
        .GroupBy(message => message.SenderEmail, StringComparer.OrdinalIgnoreCase)
        .Select(group =>
        {
            var first = group.First();
            var dates = group.Select(message => message.ReceivedAt).Where(date => date.HasValue).Select(date => date!.Value).ToList();
            return new SenderStatDto(first.SenderEmail, first.SenderName, group.Count(), first.Domain, dates.Count > 0 ? dates.Max() : null, dates.Count > 0 ? dates.Min() : null);
        })
        .ToList();

    private IEnumerable<SenderStatDto> SortSenders(IEnumerable<SenderStatDto> senders) => (sortField, sortDirection) switch
    {
        ("Name", "Asc") => senders.OrderBy(sender => sender.Name).ThenBy(sender => sender.Email),
        ("Name", _) => senders.OrderByDescending(sender => sender.Name).ThenBy(sender => sender.Email),
        ("Email", "Asc") => senders.OrderBy(sender => sender.Email),
        ("Email", _) => senders.OrderByDescending(sender => sender.Email),
        ("Newest", "Asc") => senders.OrderBy(sender => sender.NewestMessage),
        ("Newest", _) => senders.OrderByDescending(sender => sender.NewestMessage),
        ("Oldest", "Asc") => senders.OrderBy(sender => sender.OldestMessage),
        ("Oldest", _) => senders.OrderByDescending(sender => sender.OldestMessage),
        (_, "Asc") => senders.OrderBy(sender => sender.Count).ThenBy(sender => sender.Email),
        _ => senders.OrderByDescending(sender => sender.Count).ThenBy(sender => sender.Email)
    };


