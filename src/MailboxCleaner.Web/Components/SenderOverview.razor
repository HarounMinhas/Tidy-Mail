<h2>Sender overview</h2>

<div class="card mb-3">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>Filters</span>
        <button class="btn btn-sm btn-outline-secondary" @onclick="ToggleFilterPanel">@(showFilters ? "Hide" : "Show") filters</button>
    </div>
    @if (showFilters)
    {
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label">Search sender</label>
                    <input class="form-control" @bind="SearchTerm" @bind:event="oninput" placeholder="Search by name or email" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Domain</label>
                    <input class="form-control" list="domain-options" @bind="DomainFilter" @bind:event="oninput" />
                    <datalist id="domain-options">
                        @foreach (var domain in availableDomains)
                        {
                            <option value="@domain"></option>
                        }
                    </datalist>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Status</label>
                    <select class="form-select" @bind="MessageStatusFilter">
                        <option value="">All</option>
                        <option value="Unread">Unread</option>
                        <option value="Read">Read</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Folder</label>
                    <select class="form-select" @bind="FolderFilter">
                        <option value="">All</option>
                        @foreach (var folder in ExistingFolders)
                        {
                            <option value="@folder">@folder</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Attachments</label>
                    <select class="form-select" @bind="AttachmentFilterValue">
                        <option value="">All</option>
                        <option value="true">With attachment</option>
                        <option value="false">No attachment</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Autocomplete sender/keyword</label>
                    <input class="form-control" list="message-query-options" @bind="MessageQuery" @bind:event="oninput" placeholder="Search sender or keyword" />
                    <datalist id="message-query-options">
                        @foreach (var suggestion in querySuggestions)
                        {
                            <option value="@suggestion"></option>
                        }
                    </datalist>
                </div>
                <div class="col-md-2">
                    <div class="form-check mt-4">
                        <input class="form-check-input" type="checkbox" id="noreplyOnly" @bind="NoreplyOnly" />
                        <label class="form-check-label" for="noreplyOnly">Noreply only</label>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@if (isLoading)
{
    <div class="alert alert-info"><span class="spinner-border spinner-border-sm me-2"></span>@progressMessage</div>
}
@if (!string.IsNullOrWhiteSpace(successMessage))
{
    <div class="alert alert-success">@successMessage</div>
}
@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}
@if (!isLoading && !filteredSenders.Any())
{
    <div class="alert alert-warning">No senders found.</div>
}
else if (!isLoading)
{
    <div class="mb-3 text-muted">Selected messages: @engine.SelectedMessageIds.Count</div>
    <div class="row g-2 mb-3"><div class="col-md-3"><select class="form-select" @bind="SortField"><option value="Count">Message count</option><option value="Name">Sender name</option><option value="Email">Email</option><option value="Newest">Newest message</option><option value="Oldest">Oldest message</option></select></div><div class="col-md-2"><select class="form-select" @bind="SortDirection"><option value="Desc">Descending</option><option value="Asc">Ascending</option></select></div></div>

    @foreach (var sender in filteredSenders)
    {
        var senderMessages = filteredMessages.Where(message => message.SenderEmail.Equals(sender.Email, StringComparison.OrdinalIgnoreCase)).ToList();
        if (!senderMessages.Any())
        {
            continue;
        }

        var senderExpanded = engine.ExpandedSenders.Contains(sender.Email);
        <div class="card mb-2">
            <div class="card-header d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2">
                    <input type="checkbox" checked="@engine.IsSenderFullySelected(sender.Email)" @onchange="(args) => ToggleSenderSelection(sender.Email, args)" />
                    <button class="btn btn-sm btn-link text-decoration-none" @onclick="() => ToggleSender(sender.Email)">
                        @sender.Name (@sender.Email) - @senderMessages.Count mails
                    </button>
                </div>
                <span class="badge text-bg-secondary">@sender.Count total</span>
            </div>
            @if (senderExpanded)
            {
                <div class="card-body p-0">
                    <table class="table table-sm table-striped mb-0">
                        <thead>
                            <tr>
                                <th></th>
                                <th>Title</th>
                                <th>Received</th>
                                <th>Attachment</th>
                                <th>Status</th>
                                <th>Folder</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var message in senderMessages)
                            {
                                <tr>
                                    <td>
                                        <input type="checkbox" checked="@engine.SelectedMessageIds.Contains(message.Id)" @onchange="(args) => ToggleMessageSelection(message.Id, args)" />
                                    </td>
                                    <td>@message.Subject</td>
                                    <td>@(message.ReceivedAt?.ToString("yyyy-MM-dd") ?? "Unknown")</td>
                                    <td>@(message.HasAttachment ? "Yes" : "No")</td>
                                    <td>@(message.IsRead ? "Read" : "Unread")</td>
                                    <td>@message.Folder</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }

    <div class="card mt-4">
        <div class="card-header">Bulk actions</div>
        <div class="card-body d-flex flex-wrap gap-2">
            <button class="btn btn-outline-danger" disabled="@(engine.SelectedMessageIds.Count == 0 || actionInProgress)" @onclick="() => OpenActionPane(MailBulkAction.Delete)">Delete</button>
            <button class="btn btn-outline-primary" disabled="@(engine.SelectedMessageIds.Count == 0 || actionInProgress)" @onclick="() => OpenActionPane(MailBulkAction.Archive)">Archive</button>
            <button class="btn btn-outline-secondary" disabled="@(engine.SelectedMessageIds.Count == 0 || actionInProgress)" @onclick="() => OpenActionPane(MailBulkAction.MarkRead)">Mark as read</button>
            <button class="btn btn-outline-secondary" disabled="@(engine.SelectedMessageIds.Count == 0 || actionInProgress)" @onclick="() => OpenActionPane(MailBulkAction.MarkUnread)">Mark as unread</button>
            <button class="btn btn-outline-warning" disabled="@(engine.SelectedMessageIds.Count == 0 || actionInProgress)" @onclick="() => OpenActionPane(MailBulkAction.Move)">Move to label</button>
        </div>
    </div>
}

@if (showActionPane && pendingAction.HasValue)
{
    <div class="card mt-3 border-warning">
        <div class="card-header">Confirm action</div>
        <div class="card-body">
            <p>You are about to apply <strong>@pendingAction</strong> on <strong>@actionPreview?.SelectedCount</strong> messages.</p>

            @if (pendingAction == MailBulkAction.Move)
            {
                <div class="row g-2 align-items-end">
                    <div class="col-md-6">
                        <label class="form-label">Destination Gmail label</label>
                        <select class="form-select" @bind="selectedDestinationLabelId" disabled="@(!MoveDestinationLabels.Any())">
                            @if (!MoveDestinationLabels.Any())
                            {
                                <option value="">No user labels available</option>
                            }
                            @foreach (var label in MoveDestinationLabels)
                            {
                                <option value="@label.Id">@label.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Or create a new Gmail label</label>
                        <input class="form-control" @bind="newFolderName" placeholder="Enter folder name" />
                    </div>
                </div>
            }

            <div class="mt-3 d-flex gap-2">
                <button class="btn btn-success" disabled="@(!CanConfirmAction)" @onclick="ConfirmAction">@(actionInProgress ? "Working…" : "Confirm")</button>
                <button class="btn btn-outline-secondary" @onclick="CancelAction">Cancel</button>
            </div>
        </div>
    </div>
}

@code {
    private bool isLoading = true;
    private bool showFilters = true;
    private string searchTerm = string.Empty;
    private string domainFilter = string.Empty;
    private bool noreplyOnly;

    private List<SenderStatDto> allSenders = new();
    private List<SenderStatDto> filteredSenders = new();
    private List<string> availableDomains = new();

    private IReadOnlyCollection<MailItemDto> allMessages = Array.Empty<MailItemDto>();
    private IReadOnlyCollection<MailItemDto> filteredMessages = Array.Empty<MailItemDto>();
    private List<string> querySuggestions = new();

    private string messageQuery = string.Empty;
    private string messageStatusFilter = string.Empty;
    private string folderFilter = string.Empty;
    private string attachmentFilterValue = string.Empty;

    private MailManagementEngine engine = new(Array.Empty<MailItemDto>());

    private bool showActionPane;
    private MailBulkAction? pendingAction;
    private ActionPreview? actionPreview;
    private string selectedDestinationLabelId = "INBOX";
    private string newFolderName = string.Empty;
    private List<MailboxCleaner.Web.Infrastructure.Google.GmailLabel> existingLabels = new();
    private bool actionInProgress;
    private string progressMessage = "Loading Gmail metadata…";
    private string successMessage = string.Empty;
    private string errorMessage = string.Empty;
    private string sortField = "Count";
    private string sortDirection = "Desc";

    private IEnumerable<string> ExistingFolders => allMessages.Select(message => message.Folder)
        .Where(folder => !string.IsNullOrWhiteSpace(folder))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(folder => folder);

    private IReadOnlyList<MailboxCleaner.Web.Infrastructure.Google.GmailLabel> MoveDestinationLabels => existingLabels
        .Where(label => !label.IsSystemLabel)
        .OrderBy(label => label.Name)
        .ToList();

    private bool CanConfirmAction => !actionInProgress
        && pendingAction.HasValue
        && actionPreview is not null
        && actionPreview.SelectedCount > 0
        && (pendingAction != MailBulkAction.Move || !string.IsNullOrWhiteSpace(newFolderName) || !string.IsNullOrWhiteSpace(selectedDestinationLabelId));

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        isLoading = true;
        StateHasChanged();

        progressMessage = "Loading Gmail metadata…";
        allMessages = (await OverviewService.GetMailItemsAsync(CancellationToken.None)).ToList();
        allSenders = BuildSenderStats(allMessages);
        existingLabels = (await OverviewService.GetLabelsAsync(CancellationToken.None)).ToList();
        selectedDestinationLabelId = MoveDestinationLabels.FirstOrDefault()?.Id ?? string.Empty;

        engine = new MailManagementEngine(allMessages);

        availableDomains = allSenders.Select(sender => sender.Domain)
            .Where(domain => !string.IsNullOrWhiteSpace(domain))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(domain => domain)
            .ToList();

        ApplyFilters();
        isLoading = false;
    }

    private void ApplyFilters()
    {
        IEnumerable<SenderStatDto> senderResults = allSenders;

        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            senderResults = senderResults.Where(sender =>
                sender.Email.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)
                || sender.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(domainFilter))
        {
            senderResults = senderResults.Where(sender => sender.Domain.Contains(domainFilter, StringComparison.OrdinalIgnoreCase));
        }

        if (noreplyOnly)
        {
            senderResults = senderResults.Where(sender => sender.Email.Contains("noreply", StringComparison.OrdinalIgnoreCase));
        }

        filteredSenders = SortSenders(senderResults).ToList();

        filteredMessages = engine.FilterMessages(messageQuery, messageStatusFilter, folderFilter, ParseAttachmentFilter());
        querySuggestions = engine.AutocompleteSuggestions(messageQuery).ToList();
    }

    private bool? ParseAttachmentFilter() => attachmentFilterValue switch
    {
        "true" => true,
        "false" => false,
        _ => null
    };

    private void ToggleSender(string senderEmail)
    {
        engine.ToggleSenderExpansion(senderEmail);
    }

    private void ToggleSenderSelection(string senderEmail, ChangeEventArgs args)
    {
        var isChecked = args.Value is bool value && value;
        engine.ToggleSenderSelection(senderEmail, isChecked);
    }

    private void ToggleMessageSelection(string messageId, ChangeEventArgs args)
    {
        var isChecked = args.Value is bool value && value;
        engine.ToggleMessageSelection(messageId, isChecked);
    }

    private void OpenActionPane(MailBulkAction action)
    {
        pendingAction = action;
        showActionPane = true;
        actionPreview = engine.PreviewAction(action, selectedDestinationLabelId);
    }

    private async Task ConfirmAction()
    {
        if (!pendingAction.HasValue || actionPreview is null || actionPreview.SelectedCount == 0)
        {
            return;
        }

        try
        {
            actionInProgress = true;
            progressMessage = $"Applying {pendingAction} to {actionPreview.SelectedCount} messages…";
            errorMessage = string.Empty;
            successMessage = string.Empty;
            await OverviewService.ApplyActionAsync(pendingAction.Value, actionPreview.MessageIds, selectedDestinationLabelId, newFolderName, CancellationToken.None);
            successMessage = $"{pendingAction} completed for {actionPreview.SelectedCount} messages.";
            CancelAction();
            await RefreshAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"{ex.Message} Refreshing Gmail metadata to reflect any completed changes…";
            await RefreshAsync();
            errorMessage = $"{ex.Message} The mailbox was refreshed to reflect any changes that completed before the failure.";
        }
        finally
        {
            actionInProgress = false;
            progressMessage = "Loading Gmail metadata…";
        }
    }

    private void CancelAction()
    {
        showActionPane = false;
        pendingAction = null;
        actionPreview = null;
        newFolderName = string.Empty;
    }

    private void ToggleFilterPanel() => showFilters = !showFilters;


    private static List<SenderStatDto> BuildSenderStats(IEnumerable<MailItemDto> messages) => messages
        .GroupBy(message => message.SenderEmail, StringComparer.OrdinalIgnoreCase)
        .Select(group =>
        {
            var first = group.First();
            var dates = group.Select(message => message.ReceivedAt).Where(date => date.HasValue).Select(date => date!.Value).ToList();
            return new SenderStatDto(first.SenderEmail, first.SenderName, group.Count(), first.Domain, dates.Count > 0 ? dates.Max() : null, dates.Count > 0 ? dates.Min() : null);
        })
        .ToList();

    private IEnumerable<SenderStatDto> SortSenders(IEnumerable<SenderStatDto> senders) => (sortField, sortDirection) switch
    {
        ("Name", "Asc") => senders.OrderBy(sender => sender.Name).ThenBy(sender => sender.Email),
        ("Name", _) => senders.OrderByDescending(sender => sender.Name).ThenBy(sender => sender.Email),
        ("Email", "Asc") => senders.OrderBy(sender => sender.Email),
        ("Email", _) => senders.OrderByDescending(sender => sender.Email),
        ("Newest", "Asc") => senders.OrderBy(sender => sender.NewestMessage),
        ("Newest", _) => senders.OrderByDescending(sender => sender.NewestMessage),
        ("Oldest", "Asc") => senders.OrderBy(sender => sender.OldestMessage),
        ("Oldest", _) => senders.OrderByDescending(sender => sender.OldestMessage),
        (_, "Asc") => senders.OrderBy(sender => sender.Count).ThenBy(sender => sender.Email),
        _ => senders.OrderByDescending(sender => sender.Count).ThenBy(sender => sender.Email)
    };


    private string SortField
    {
        get => sortField;
        set
        {
            sortField = value;
            ApplyFilters();
        }
    }

    private string SortDirection
    {
        get => sortDirection;
        set
        {
            sortDirection = value;
            ApplyFilters();
        }
    }

    private string SearchTerm
    {
        get => searchTerm;
        set
        {
            searchTerm = value;
            ApplyFilters();
        }
    }

    private string DomainFilter
    {
        get => domainFilter;
        set
        {
            domainFilter = value;
            ApplyFilters();
        }
    }

    private bool NoreplyOnly
    {
        get => noreplyOnly;
        set
        {
            noreplyOnly = value;
            ApplyFilters();
        }
    }

    private string MessageQuery
    {
        get => messageQuery;
        set
        {
            messageQuery = value;
            ApplyFilters();
        }
    }

    private string MessageStatusFilter
    {
        get => messageStatusFilter;
        set
        {
            messageStatusFilter = value;
            ApplyFilters();
        }
    }

    private string FolderFilter
    {
        get => folderFilter;
        set
        {
            folderFilter = value;
            ApplyFilters();
        }
    }

    private string AttachmentFilterValue
    {
        get => attachmentFilterValue;
        set
        {
            attachmentFilterValue = value;
            ApplyFilters();
        }
    }
}
