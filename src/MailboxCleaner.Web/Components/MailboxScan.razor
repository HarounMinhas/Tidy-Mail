@using MailboxCleaner.Web.Application.MailboxScanning
@using Microsoft.JSInterop
@inject MailboxScanService ScanService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IDisposable

<div class="card border-0 shadow-sm mailbox-scan mx-auto">
    <div class="card-body p-3 p-md-4">
        <div class="small text-uppercase text-muted fw-semibold mb-2">Tidy Mail / Mailbox setup</div>
        <h2 class="h3">@(scanRunning ? "Scanning your mailbox" : scanState.Status switch {
            MailboxScanStatus.Failed => "Mailbox scan needs attention",
            MailboxScanStatus.Completed => "Your mailbox is ready",
            MailboxScanStatus.Cancelled => "Mailbox scan cancelled",
            _ => "Scan your mailbox" })</h2>
        <p class="text-muted">We fetch metadata only, never email contents. Your message metadata is stored locally by Tidy Mail.</p>
        <div class="rounded border bg-light p-3 my-3">
            <ScanProgressBar State="scanState" />
        </div>
        @if (!string.IsNullOrWhiteSpace(scanState.ErrorMessage))
        {
            <div class="alert alert-danger" role="alert">@scanState.ErrorMessage
                @if (scanState.ErrorMessage.Contains("sign in again", StringComparison.OrdinalIgnoreCase)
                    || scanState.ErrorMessage.Contains("token missing", StringComparison.OrdinalIgnoreCase))
                {
                    <div class="mt-2"><a href="/auth/login" class="btn btn-sm btn-outline-primary" data-enhance-nav="false">Reconnect Google account</a></div>
                }
            </div>
        }
        <div class="mt-3 d-flex flex-wrap gap-2">
            <button class="btn btn-primary" disabled="@scanRunning" @onclick="StartScan">@(scanRunning ? "Scanning…" : "Start scan")</button>
            <button class="btn btn-outline-secondary" disabled="@(!scanRunning)" @onclick="CancelScan">Cancel scan</button>
            <button class="btn btn-success" disabled="@(scanRunning || (!canContinueToDashboard && scanState.Status != MailboxScanStatus.Completed))" @onclick="ContinueToDashboard">@(scanState.Status == MailboxScanStatus.Completed ? "Continue to dashboard" : "Use previous scan")</button>
        </div>
        <details class="mt-4 border-top pt-3">
            <summary class="small fw-semibold">Developer diagnostics</summary>
            <p class="small text-muted mt-2 mb-0">Open the browser developer console (F12 → Console) and filter for [TidyMail:scan]. Scan stages, counts, retry attempts and safe error codes are logged automatically. No email addresses, subjects, message IDs or tokens are logged.</p>
        </details>
    </div>
</div>

@code {
    [Parameter] public string UserId { get; set; } = "session";
    private MailboxScanState scanState = new();
    private CancellationTokenSource? cancellation;
    private bool scanRunning;
    private bool canContinueToDashboard;
    private bool disposed;
    private string? lastLog;

    protected override async Task OnInitializedAsync()
    {
        scanState = await ScanService.GetOrCreateScanAsync(UserId, CancellationToken.None);
        canContinueToDashboard = scanState.Status == MailboxScanStatus.Completed;
    }

    private async Task LogScanAsync(string level, string message)
    {
        if (disposed || lastLog == message) return;
        lastLog = message;
        try
        {
            await JS.InvokeVoidAsync("console." + level, $"[TidyMail:scan] {DateTimeOffset.UtcNow:O} {message}");
        }
        catch (JSException) { /* Diagnostics must never prevent scanning. */ }
        catch (InvalidOperationException) { /* JS unavailable during prerender/disconnect. */ }
        catch (OperationCanceledException) { }
    }

    private Task LogStateAsync(MailboxScanState state)
    {
        var level = state.Status == MailboxScanStatus.Failed ? "error"
            : state.Status == MailboxScanStatus.Cancelled || state.DiagnosticMessage is not null ? "warn" : "info";
        return LogScanAsync(level,
            $"{state.StatusMessage} | page={state.CurrentPage} | scanned={state.ScannedMessages} | discovered={state.TotalDiscoveredMessages?.ToString() ?? "unknown"}"
            + (state.DiagnosticMessage is null ? "" : $" | {state.DiagnosticMessage}")
            + (state.ErrorMessage is null ? "" : $" | {state.ErrorMessage}"));
    }

    private async Task StartScan()
    {
        if (scanRunning || disposed) return;
        cancellation = new CancellationTokenSource();
        scanRunning = true;
        lastLog = null;
        scanState = new MailboxScanState { UserId = UserId };
        try
        {
            await LogScanAsync("info", "Start scan requested");
            var progress = new Progress<MailboxScanState>(state =>
            {
                if (disposed || !scanRunning) return;
                scanState = state;
                StateHasChanged();
                _ = LogStateAsync(state);
            });
            scanState = await ScanService.ScanAsync(UserId, progress, cancellation.Token);
            // Stop queued progress callbacks before displaying the authoritative result.
            scanRunning = false;
            await LogStateAsync(scanState);
            var persisted = await ScanService.GetOrCreateScanAsync(UserId, CancellationToken.None);
            canContinueToDashboard = persisted.Status == MailboxScanStatus.Completed;
        }
        catch (OperationCanceledException) when (cancellation?.IsCancellationRequested == true)
        {
            scanState = scanState with { Status = MailboxScanStatus.Cancelled, StatusMessage = "Mailbox scan cancelled" };
            await LogStateAsync(scanState);
        }
        catch (Exception)
        {
            scanState = scanState with { Status = MailboxScanStatus.Failed, StatusMessage = "Mailbox scan failed",
                ErrorMessage = "Unable to start or finish the scan. Check the application server diagnostics." };
            await LogStateAsync(scanState);
        }
        finally
        {
            scanRunning = false;
            cancellation?.Dispose();
            cancellation = null;
        }
    }

    private async Task CancelScan()
    {
        cancellation?.Cancel();
        await LogScanAsync("warn", "Cancellation requested");
    }

    private void ContinueToDashboard() => Navigation.NavigateTo("/overview", forceLoad: true);
    public void Dispose()
    {
        disposed = true;
        cancellation?.Cancel();
    }
}
