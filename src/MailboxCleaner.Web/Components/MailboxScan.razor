@using MailboxCleaner.Web.Application.MailboxScanning
@inject MailboxScanService ScanService
@inject NavigationManager Navigation
@implements IDisposable

<div class="tm-scan-page">
    <div class="tm-page-heading">
        <div><div class="tm-eyebrow">MAILBOX SCAN</div><h1>Scanning your mailbox</h1><p class="tm-subtitle">Understand your inbox without opening a single message.</p></div>
    </div>
    <div class="tm-scan-panel tm-panel">
        <div class="tm-scan-icon" aria-hidden="true">✉</div>
        <h2>@(scanRunning ? "We're checking your mailbox" : scanState.Status == MailboxScanStatus.Completed ? "Scan complete" : "Ready to scan")</h2>
        <p class="tm-subtitle">Only metadata is fetched: sender, subject, date, labels, read status, and attachment indicators. No message bodies.</p>
        <div class="tm-scan-progress-area"><ScanProgressBar State="scanState" /></div>
        @if (!string.IsNullOrWhiteSpace(scanState.ErrorMessage))
        {
            <div class="alert alert-danger mt-3" role="alert">@scanState.ErrorMessage
                @if (scanState.ErrorMessage.Contains("sign in again", StringComparison.OrdinalIgnoreCase)
                  || scanState.ErrorMessage.Contains("token missing", StringComparison.OrdinalIgnoreCase))
                {
                    <div class="mt-2"><a href="/auth/login" class="btn btn-sm btn-outline-primary">Reconnect Google account</a></div>
                }
            </div>
        }
        <div class="tm-scan-actions">
            <button class="btn btn-primary" disabled="@scanRunning" @onclick="StartScan">@(scanRunning ? "Scanning…" : scanState.Status == MailboxScanStatus.Completed ? "Scan again" : "Start mailbox scan")</button>
            <button class="btn btn-outline-secondary" disabled="@(!scanRunning)" @onclick="CancelScan">Cancel scan</button>
            <button class="btn btn-outline-primary" disabled="@(!canContinueToDashboard && scanState.Status != MailboxScanStatus.Completed)" @onclick="ContinueToDashboard">@(scanState.Status == MailboxScanStatus.Completed ? "Open dashboard" : "Use previous scan")</button>
        </div>
    </div>
    <div class="tm-scan-details">
        <section class="tm-panel">
            <h2>What we collect</h2>
            <div class="tm-detail-grid">
                <div><strong>Sender</strong><span>Who sent the email</span></div>
                <div><strong>Subject</strong><span>The subject line</span></div>
                <div><strong>Date</strong><span>When it arrived</span></div>
                <div><strong>Labels</strong><span>Gmail categories and labels</span></div>
                <div><strong>Read status</strong><span>Read or unread</span></div>
                <div><strong>Attachments</strong><span>Presence, not contents</span></div>
            </div>
        </section>
        <section class="tm-panel tm-privacy-panel">
            <h2>Your data stays yours</h2>
            <p>The metadata cache is used to provide fast local filtering and mailbox statistics. No message bodies are downloaded.</p>
            <p><strong>No messages are modified during scanning.</strong> Every cleanup action requires a separate preview and confirmation.</p>
        </section>
    </div>
</div>

@code {
    [Parameter] public string UserId { get; set; } = "session";
    private MailboxScanState scanState = new();
    private CancellationTokenSource? cancellation;
    private bool scanRunning;
    private bool canContinueToDashboard;

    protected override async Task OnInitializedAsync()
    {
        scanState = await ScanService.GetOrCreateScanAsync(UserId, CancellationToken.None);
        canContinueToDashboard = scanState.Status == MailboxScanStatus.Completed;
    }

    private async Task StartScan()
    {
        if (scanRunning) return;
        cancellation = new CancellationTokenSource();
        scanRunning = true;
        scanState = new MailboxScanState { UserId = UserId };
        try
        {
            var progress = new Progress<MailboxScanState>(state =>
            {
                if (!scanRunning || scanState.Status == MailboxScanStatus.Completed && state.Status != MailboxScanStatus.Completed)
                    return;
                scanState = state;
                _ = InvokeAsync(StateHasChanged);
            });
            scanState = await ScanService.ScanAsync(UserId, progress, cancellation.Token);
            var persisted = await ScanService.GetOrCreateScanAsync(UserId, CancellationToken.None);
            canContinueToDashboard = persisted.Status == MailboxScanStatus.Completed;
        }
        finally
        {
            scanRunning = false;
            cancellation?.Dispose();
            cancellation = null;
        }
    }

    private void CancelScan() => cancellation?.Cancel();
    private void ContinueToDashboard() => Navigation.NavigateTo("/overview", forceLoad: true);
    public void Dispose()
    {
        cancellation?.Cancel();
    }
}
