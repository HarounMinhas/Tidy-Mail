@using MailboxCleaner.Web.Application.MailboxScanning
@inject MailboxScanService ScanService
@inject NavigationManager Navigation
@implements IDisposable

<div class="card border-primary">
    <div class="card-body">
        <h2>We are scanning your mailbox</h2>
        <p class="text-muted">We only fetch metadata, never mail contents. Tidy Mail stores message IDs, sender, subject, dates, labels, read state, attachment flags, and cleanup headers locally for this session.</p>
        <ScanProgressBar State="scanState" />
        @if (!string.IsNullOrWhiteSpace(scanState.ErrorMessage))
        {
            <div class="alert alert-danger mt-3">@scanState.ErrorMessage</div>
        }
        <div class="mt-3 d-flex gap-2">
            <button class="btn btn-primary" disabled="@scanRunning" @onclick="StartScan">@(scanRunning ? "Scanning…" : "Start scan")</button>
            <button class="btn btn-outline-secondary" disabled="@(!scanRunning)" @onclick="CancelScan">Cancel scan</button>
            <button class="btn btn-success" disabled="@(scanState.Status != MailboxScanStatus.Completed)" @onclick="ContinueToDashboard">Continue to dashboard</button>
        </div>
    </div>
</div>

@code {
    [Parameter] public string UserId { get; set; } = "session";
    private MailboxScanState scanState = new();
    private CancellationTokenSource? cancellation;
    private bool scanRunning;

    protected override async Task OnInitializedAsync()
    {
        scanState = await ScanService.GetOrCreateScanAsync(UserId, CancellationToken.None);
    }

    private async Task StartScan()
    {
        if (scanRunning) return;
        cancellation = new CancellationTokenSource();
        scanRunning = true;
        scanState = new MailboxScanState { UserId = UserId };
        try
        {
            var progress = new Progress<MailboxScanState>(state =>
            {
                if (!scanRunning || scanState.Status == MailboxScanStatus.Completed && state.Status != MailboxScanStatus.Completed)
                    return;
                scanState = state;
                _ = InvokeAsync(StateHasChanged);
            });
            scanState = await ScanService.ScanAsync(UserId, progress, cancellation.Token);
        }
        finally
        {
            scanRunning = false;
            cancellation?.Dispose();
            cancellation = null;
        }
    }

    private void CancelScan() => cancellation?.Cancel();
    private void ContinueToDashboard() => Navigation.NavigateTo("/overview", forceLoad: true);
    public void Dispose()
    {
        cancellation?.Cancel();
    }
}
