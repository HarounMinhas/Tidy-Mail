@using System.Security.Claims
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation
@inject IWebHostEnvironment HostEnvironment
@inject IConfiguration Configuration

@if (isAuthenticated)
{
    <div class="text-white d-flex align-items-center gap-2">
        <span class="small">@displayName</span>
        <button class="btn btn-outline-light btn-sm" @onclick="SignOut">@(IsDemo ? "Leave demo" : "Logout")</button>
    </div>
}
else if (IsDemo)
{
    <div class="d-flex gap-2">
        <a class="btn btn-outline-light btn-sm" href="/demo/login?account=alice" data-enhance-nav="false">Demo Alice</a>
        <a class="btn btn-outline-light btn-sm" href="/demo/login?account=bob" data-enhance-nav="false">Demo Bob</a>
    </div>
}
else
{
    <a class="btn btn-outline-light btn-sm" href="/auth/login" data-enhance-nav="false">Login with Google</a>
}

@code {
    private bool isAuthenticated;
    private string displayName = string.Empty;

    private bool IsDemo => HostEnvironment.IsDevelopment() && Configuration.GetValue<bool>("Mailbox:DemoMode");

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        isAuthenticated = auth.User.Identity?.IsAuthenticated == true;
        displayName = auth.User.Identity?.Name ?? "Account";
    }

    private void SignOut()
    {
        Navigation.NavigateTo(IsDemo ? "/demo/logout" : "/auth/logout", forceLoad: true);
    }
}
