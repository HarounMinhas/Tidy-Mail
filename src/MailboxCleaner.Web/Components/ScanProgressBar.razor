@using MailboxCleaner.Web.Application.MailboxScanning

<div class="scan-progress">
    <div class="d-flex justify-content-between mb-1">
        <strong>@State.StatusMessage</strong>
        <span>@State.ProgressPercent%</span>
    </div>
    <div class="progress" role="progressbar" aria-label="Mailbox scan progress" aria-valuenow="@State.ProgressPercent" aria-valuemin="0" aria-valuemax="100">
        <div class="progress-bar @(State.Status == MailboxScanStatus.Failed ? "bg-danger" : State.Status == MailboxScanStatus.Completed ? "bg-success" : "")" style="width:@(State.ProgressPercent.ToString(System.Globalization.CultureInfo.InvariantCulture))%"></div>
    </div>
    <div class="small text-muted mt-2" role="status" aria-live="polite">
        Scanned @State.ScannedMessages messages
        @if (State.TotalDiscoveredMessages.HasValue)
        {
            <span> of @State.TotalDiscoveredMessages.Value discovered</span>
        }
        <span> · Gmail page @State.CurrentPage</span>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public MailboxScanState State { get; set; } = new();
}
